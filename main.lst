023A:  CLRF   17
023C:  CLRF   16
023E:  BTFSC  FF2.7
0240:  BSF    16.7
0242:  BCF    FF2.7
....................   actualizarT2CON(); 
0244:  RCALL  00BC
0246:  BTFSC  16.7
0248:  BSF    FF2.7
....................  
....................   enableExternalInterrupts(); 
024A:  BRA    01B8
....................  
....................   while (TRUE) { 
....................     int16 adcValue; 
....................  
....................     adcValue = readADC0(); 
024C:  BRA    01C6
024E:  MOVFF  02,19
0252:  MOVFF  01,18
....................     if (adcValue > (((int16)PR2 + 1) * 4 - 1)) { 
0256:  CLRF   1B
0258:  MOVFF  FCB,1A
025C:  MOVLW  01
025E:  ADDWF  1A,F
0260:  MOVLW  00
0262:  ADDWFC 1B,F
0264:  RLCF   1A,F
0266:  RLCF   1B,F
0268:  RLCF   1A,F
026A:  RLCF   1B,F
026C:  MOVLW  FC
026E:  ANDWF  1A,F
0270:  MOVLW  01
0272:  SUBWF  1A,W
0274:  MOVWF  00
0276:  MOVLW  00
0278:  SUBWFB 1B,W
027A:  MOVWF  03
027C:  MOVFF  00,01
0280:  MOVF   03,W
0282:  SUBWF  19,W
0284:  BNC   02B4
0286:  BNZ   028E
0288:  MOVF   18,W
028A:  SUBWF  01,W
028C:  BC    02B4
....................       adcValue = (((int16)PR2 + 1) * 4 - 1); 
028E:  CLRF   1B
0290:  MOVFF  FCB,1A
0294:  MOVLW  01
0296:  ADDWF  1A,F
0298:  MOVLW  00
029A:  ADDWFC 1B,F
029C:  RLCF   1A,F
029E:  RLCF   1B,F
02A0:  RLCF   1A,F
02A2:  RLCF   1B,F
02A4:  MOVLW  FC
02A6:  ANDWF  1A,F
02A8:  MOVLW  01
02AA:  SUBWF  1A,W
02AC:  MOVWF  18
02AE:  MOVLW  00
02B0:  SUBWFB 1B,W
02B2:  MOVWF  19
....................     } 
....................     //^ Esto es para evitar que el valor del ADC exceda el máximo permitido por el periodo actual del PWM, causando que truene. 
....................  
....................     setPWM1Duty10(adcValue); 
02B4:  MOVFF  19,1D
02B8:  MOVFF  18,1C
02BC:  RCALL  0108
....................  
....................     delay_ms(10); 
02BE:  MOVLW  0A
02C0:  MOVWF  1A
02C2:  BRA    01F6
02C4:  BRA    024C
....................   } 
